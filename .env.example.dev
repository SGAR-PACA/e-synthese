# =============================================================================
# E-Synthese RAG Proxy - Configuration DEVELOPPEMENT
# =============================================================================
# Copiez ce fichier en .env pour tester en local :
#   cp .env.example.dev .env
#
# Rappel : ce backend se fait passer pour un endpoint LLM OpenAI-compatible
# (via Mastra) afin qu'Albert Conversation l'appelle comme un modele standard,
# alors qu'en realite il execute un pipeline RAG complet en interne.
# =============================================================================

# --- Mode ---
# development : auto-generation des secrets manquants, HTTP autorise (cookies sans Secure).
NODE_ENV=development

# --- Securite ---
# En dev, laisser vide : une cle temporaire est generee a chaque demarrage.
# Attention : les secrets chiffres en base seront illisibles apres un restart.
ENCRYPTION_KEY=

# --- Albert API ---
# Obligatoire meme en dev pour que le pipeline RAG fonctionne.
# Inscription : https://albert.api.etalab.gouv.fr
ALBERT_API_KEY=
ALBERT_API_BASE_URL=https://albert.api.etalab.gouv.fr

# --- Cle API du proxy (Bearer) ---
# En dev, laisser vide : une cle temporaire est generee et imprimee dans les logs au boot.
# Reprenez-la pour vos appels curl / pour configurer Albert Conversation en local.
PROXY_API_KEY=

# --- Serveur ---
PORT=4111

# --- Pipeline RAG (optionnel - valeurs par defaut adaptees au dev) ---
# Modele LLM Albert utilise pour la generation finale.
LLM_MODEL=albert-large
# Nombre de chunks remontes par la recherche.
SEARCH_K=5
# Score minimum pour qu'un chunk soit conserve (0.0 - 1.0).
MIN_SCORE=0.5
# Activer le reranking (true/false).
USE_RERANK=true
# Collections Albert par defaut (IDs separes par virgules). Vide = toutes.
DEFAULT_COLLECTIONS=

# --- Chemins (optionnel) ---
# Par defaut : <projet>/data.db et <projet>/public
# DB_PATH=
# PUBLIC_DIR=

# =============================================================================
# E-Synthèse Final-Dev — variables d'environnement (DÉVELOPPEMENT)
# =============================================================================
# Copier ce fichier en .env (fait automatiquement par ./scripts/bootstrap.sh) :
#   cp .env.example .env
#
# Toutes les valeurs PROXY_API_KEY = "sk-proxy-PLACEHOLDER" sont remplacées
# par bootstrap.sh par une clé aléatoire générée localement.
# =============================================================================

# --- Mastra ---
NODE_ENV=development

# Bearer token partagé entre Mastra et Conversations.
# Auto-généré par bootstrap.sh — ne pas modifier à la main.
PROXY_API_KEY=sk-proxy-PLACEHOLDER

# Clé API Albert (https://albert.api.etalab.gouv.fr).
# REMPLIR MANUELLEMENT pour que le pipeline RAG fonctionne (sinon Mastra
# démarre mais les requêtes /v1/chat/completions échouent côté Albert).
ALBERT_API_KEY=
ALBERT_API_BASE_URL=https://albert.api.etalab.gouv.fr

# Clé de chiffrement des secrets en base SQLite Mastra.
# Vide en dev = clé temporaire générée par Mastra à chaque démarrage
# (les secrets stockés en base seront illisibles après un restart).
ENCRYPTION_KEY=

# Port d'écoute interne de Mastra.
PORT=4111

# --- Pipeline RAG (optionnel) ---
LLM_MODEL=albert-large
SEARCH_K=5
MIN_SCORE=0.5
USE_RERANK=true
DEFAULT_COLLECTIONS=

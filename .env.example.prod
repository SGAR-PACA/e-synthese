# =============================================================================
# E-Synthese RAG Proxy - Configuration PRODUCTION
# =============================================================================
# Copiez ce fichier en .env (ou injectez via votre orchestrateur) :
#   cp .env.example.prod .env
#
# Rappel : ce backend se fait passer pour un endpoint LLM OpenAI-compatible
# (via Mastra) afin qu'Albert Conversation l'appelle comme un modele standard,
# alors qu'en realite il execute un pipeline RAG complet en interne.
#
# IMPORTANT : toutes les variables marquees [OBLIGATOIRE] doivent etre definies
# sinon le serveur refuse de demarrer ou les fonctionnalites seront degradees.
# =============================================================================

# --- Mode ---
# [OBLIGATOIRE] production : cookies Secure, HTTPS attendu, secrets stricts.
NODE_ENV=production

# --- Securite ---
# [OBLIGATOIRE] Cle de chiffrement des secrets stockes en base (64 hex chars).
# Generation :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A stocker dans un secret manager (Vault / AWS Secrets Manager / k8s Secret).
# Ne JAMAIS la regenerer apres deploiement : les secrets en base seraient perdus.
ENCRYPTION_KEY=

# --- Albert API ---
# [OBLIGATOIRE] Cle API Albert (https://albert.api.etalab.gouv.fr).
ALBERT_API_KEY=
ALBERT_API_BASE_URL=https://albert.api.etalab.gouv.fr

# --- Cle API du proxy (Bearer) ---
# [OBLIGATOIRE] Cle requise pour appeler /v1/chat/completions, /v1/search,
# /v1/rerank, /v1/embeddings, /v1/models depuis Albert Conversation ou tout
# client OpenAI-compatible. Generation :
#   node -e "console.log('sk-proxy-' + require('crypto').randomBytes(32).toString('hex'))"
PROXY_API_KEY=

# --- Serveur ---
# Port d'ecoute interne. Le reverse proxy (nginx / Caddy / Traefik) doit
# terminer le TLS et forwarder vers ce port.
PORT=4111

# --- Pipeline RAG (a ajuster selon le volume documentaire) ---
LLM_MODEL=albert-large
SEARCH_K=5
MIN_SCORE=0.5
USE_RERANK=true
# Collections Albert par defaut (IDs separes par virgules). Vide = toutes.
DEFAULT_COLLECTIONS=

# --- Chemins (Docker/k8s) ---
# Volume persistant monte pour la base SQLite.
DB_PATH=/data/data.db
# Repertoire des assets de l'admin UI (servi par le serveur).
PUBLIC_DIR=/app/public

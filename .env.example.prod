# =============================================================================
# E-Synthèse — variables d'environnement de production
# =============================================================================
# Modèle à recopier dans Dokploy (Application > Environment) avant le premier
# déploiement. Ne jamais versionner de valeurs réelles : le vrai fichier .env
# n'existe que sur le serveur, géré par Dokploy.
#
# Génération des secrets :
#   openssl rand -hex 32     # mots de passe, clés HMAC, ENCRYPTION_KEY
#   openssl rand -hex 50     # DJANGO_SECRET_KEY
#
# Référence complète : docs/variables-environnement.md
# =============================================================================

# --- Domaine ------------------------------------------------------------------
# Domaine unique : interface (/), Keycloak (/auth), Mastra (/admin et /v1).
# Un enregistrement DNS de type A doit pointer vers l'IP du serveur.
DOMAIN_FRONT=esynthese.example.fr
# Nom affiché dans l'interface de chat (intégré au build du frontend).
PRODUCT_NAME=E-Synthèse

# --- Mastra : clés --------------------------------------------------------------
# Clé partagée entre le backend Conversations et Mastra (préfixe « sk-proxy- »).
PROXY_API_KEY=sk-proxy-REMPLACER
# Chiffre la clé Albert stockée en base Mastra (64 caractères hexadécimaux).
# CRITIQUE : sa perte rend la clé enregistrée illisible. À garder en coffre-fort.
ENCRYPTION_KEY=
# Mot de passe de la base PostgreSQL de Mastra.
MASTRA_DB_PASSWORD=

# --- Albert API -----------------------------------------------------------------
ALBERT_API_KEY=
ALBERT_API_BASE_URL=https://albert.api.etalab.gouv.fr
# Plafond de requêtes par minute vers Albert (quota de la clé, avec marge).
# Compteur en mémoire : une seule instance de Mastra est supportée.
ALBERT_MAX_RPM=8

# --- Génération (modifiable ensuite dans l'admin Mastra, qui est prioritaire) ---
LLM_MODEL=openweight-large
LLM_TEMPERATURE=0.2
# 1 = désactivé. Régler soit la température, soit top_p, pas les deux.
LLM_TOP_P=1
LLM_MAX_OUTPUT_TOKENS=2048

# --- Recherche documentaire (idem : l'admin Mastra est prioritaire) -------------
MAX_SEARCH_QUERIES=2
SEARCH_WIDE_K=20
FINAL_K=8
USE_RERANK=true
RERANK_MIN_SCORE=0.2
# Seuil utilisé uniquement quand le rerank est désactivé.
MIN_SCORE=0.5
# Hérité : sans effet sur le pipeline de chat actuel.
SEARCH_K=5

# --- Évaluation automatique (LLM juge) ------------------------------------------
# Doit être différent de LLM_MODEL.
ALBERT_JUDGE_MODEL=deepseek-v4-flash
JUDGE_TEMPERATURE=0
JUDGE_MAX_COMPLETION_TOKENS=512
# Part des réponses évaluées (0 = jamais, 1 = toutes). Garder bas : la clé Albert est partagée.
EVAL_SAMPLING_RATE=0.1
# Recherche supplémentaire pour le juge (+1 appel Albert) : réservée aux audits.
EVAL_WIDE_SEARCH=false
EVAL_WIDE_K=20

# --- Documents sources (ingestion, OCR, visionneuse) ----------------------------
# Bucket S3 des PDF. Sans bucket, l'ingestion et la visionneuse sont désactivées.
S3_DOCS_ENDPOINT=https://s3.fr-par.scw.cloud
S3_DOCS_REGION=fr-par
S3_DOCS_BUCKET=
S3_DOCS_ACCESS_KEY=
S3_DOCS_SECRET_KEY=

# --- Visionneuse de sources : authentification ---------------------------------
# Secret du client Keycloak confidentiel « mastra-sources » (appliqué à chaque déploiement).
MASTRA_OIDC_CLIENT_SECRET=
# Clé HMAC du cookie de connexion (32 caractères minimum).
MASTRA_RP_COOKIE_KEY=
# Clé HMAC des liens de sources (32 caractères minimum). Vide = sources non cliquables.
MASTRA_SOURCE_LINK_KEY=
# Durée de session de la visionneuse, bornée par le code entre 10 h et 24 h.
MASTRA_SOURCE_SESSION_TTL_SECONDS=36000
# Facultatif : URL de déconnexion back-channel si Keycloak n'est pas le conteneur local.
MASTRA_OIDC_BACKCHANNEL_LOGOUT_URL=

# --- Conversations (backend Django) ---------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_EMAIL_BRAND_NAME=E-Synthèse
# Base PostgreSQL de Conversations.
POSTGRES_PASSWORD=
# Secret du client Keycloak « conversations » : à régénérer dans Keycloak après
# le premier démarrage, puis à recopier ici (voir docs/deploiement.md).
OIDC_RP_CLIENT_SECRET=
# Durée de session : 10 h, alignée sur le SSO Keycloak.
CONVERSATIONS_SESSION_COOKIE_AGE=36000
# Mot de passe du stockage MinIO (pièces jointes du chat).
AWS_S3_SECRET_ACCESS_KEY=

# --- Keycloak -------------------------------------------------------------------
KC_DB_PASSWORD=
# Compte « admin » de la console Keycloak (realm master).
KEYCLOAK_ADMIN_PASSWORD=

# --- E-mails (SMTP) -------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# --- Sauvegardes (Scaleway Object Storage) --------------------------------------
# Clé IAM limitée au bucket de sauvegarde (BACKUP_S3_BUCKET).
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

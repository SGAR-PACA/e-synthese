# =============================================================================
# E-Synthèse Final — variables d'environnement PRODUCTION
# =============================================================================
# Toutes les variables ci-dessous DOIVENT être renseignées dans Dokploy
# (UI > Application > Environment Variables) AVANT le premier déploiement.
#
# Ce fichier sert uniquement de modèle / checklist. Il ne doit JAMAIS être
# commité avec des valeurs réelles. Le vrai .env n'existe que côté serveur,
# géré par Dokploy.
#
# Pour générer les secrets aléatoires :
#   openssl rand -hex 32          # PROXY_API_KEY (préfixer "sk-proxy-"), ENCRYPTION_KEY,
#                                 # SESSION_SECRET, AWS_S3_SECRET_ACCESS_KEY, KC_DB_PASSWORD,
#                                 # POSTGRES_PASSWORD, OIDC_RP_CLIENT_SECRET
#   openssl rand -hex 50          # DJANGO_SECRET_KEY
# =============================================================================

# --- Domaines (Traefik / Let's Encrypt) ---
# Chacun doit pointer en DNS (record A) vers l'IP du serveur.
DOMAIN_FRONT=esynthese.example.fr
DOMAIN_AUTH=auth-esynthese.example.fr

# --- Mastra ---
# Bearer token partagé entre Mastra et Conversations.
# Préfixer impérativement "sk-proxy-".
PROXY_API_KEY=sk-proxy-REMPLACER

# Clé API Albert (https://albert.api.etalab.gouv.fr).
ALBERT_API_KEY=
ALBERT_API_BASE_URL=https://albert.api.etalab.gouv.fr

# Clé de chiffrement des secrets en base SQLite Mastra.
# CRITIQUE — perte = impossible de relire les secrets stockés.
# Stocker une copie dans un coffre-fort (Bitwarden, 1Password, etc.).
ENCRYPTION_KEY=

# Modèle Albert utilisé pour la génération. Défaut : openweight-large (gpt-oss-120b, 131k ctx).
# Note : `albert-large` a été RETIRÉ du catalogue Albert (→ 404). Aussi pilotable depuis l'admin.
LLM_MODEL=openweight-large

# --- Notation (LLM-juge) ---
# Modèle du juge. DOIT différer de LLM_MODEL (sinon biais d'auto-préférence).
# Défaut : openweight-medium (Mistral Small 24B). Aussi pilotable depuis l'admin.
ALBERT_JUDGE_MODEL=openweight-medium
# Part des réponses notées (0 = désactivé, 1 = 100 %). La clé Albert (~10 req/min) est
# PARTAGÉE par tous les users ; garder bas. Aussi pilotable depuis l'admin.
EVAL_SAMPLING_RATE=0.3
# Plafond de req/min du limiteur Albert global (marge sous le quota dur de la clé).
# Régler sur le quota RÉEL de la clé. ⚠️ par-process : une seule replica mastra.
ALBERT_MAX_RPM=9

# --- Postgres Mastra (storage : traces, evals, mémoire) ---
# Mot de passe de la base PostgreSQL dédiée à Mastra.
# Générer avec : openssl rand -hex 32
MASTRA_DB_PASSWORD=

# --- Conversations / Django ---
DJANGO_SECRET_KEY=
DJANGO_EMAIL_BRAND_NAME=E-Synthèse

# --- Postgres principal (Conversations) ---
POSTGRES_PASSWORD=

# --- Postgres Keycloak ---
KC_DB_PASSWORD=

# --- Keycloak admin ---
KEYCLOAK_ADMIN_PASSWORD=

# --- OIDC ---
# Doit correspondre au "Client Secret" du client `conversations` dans Keycloak.
# À régénérer dans l'admin Keycloak après le premier import du realm.
OIDC_RP_CLIENT_SECRET=

# --- MinIO / stockage S3 ---
# Mot de passe du root user MinIO (et secret access key utilisé par Django).
AWS_S3_SECRET_ACCESS_KEY=

# --- Email transactionnel (SMTP) ---
# Service SMTP de votre choix (ex : Mailjet, SendGrid, OVH SMTP).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# --- (Optionnel) GHCR si vous utilisez l'image Mastra publiée par CI ---
# REPO_OWNER=ton-org-github

# --- Sauvegardes Scaleway Object Storage ---
# Clé d'API IAM Scaleway avec scope restreint au bucket e-synthese-backups.
# Voir DEPLOY.md section « Sauvegardes » pour la procédure de création.
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
